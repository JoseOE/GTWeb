# Plantilla de configuración. Copia este archivo como ".env" (en la raíz del
# proyecto, junto a pom.xml) y sustituye los valores entre < >.
# El .env real NO se sube a GitHub; esta plantilla sí, para que cualquiera
# del equipo sepa qué necesita.

MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/gymtrackdb?retryWrites=true&w=majority

# Correos de la cuenta (verificación, recuperación, avisos), por la API de Brevo.
# BREVO_API_KEY sale de tu cuenta de Brevo: SMTP & API > API Keys > Generate a new API key.
# MAIL_USERNAME debe estar verificado como remitente en Brevo: Senders, Domains & Dedicated IPs.
BREVO_API_KEY=<api key de Brevo>
MAIL_USERNAME=<correo>@gmail.com

# Pagos: sandbox = las APIs reales en su modo de pruebas (sin dinero real);
# simulado = los simuladores internos, sin llaves (solo para las pruebas del CI).
PAGOS_MODO=sandbox
# Stripe (dashboard.stripe.com, modo de prueba → Desarrolladores → Claves de API)
STRIPE_PUBLISHABLE_KEY=pk_test_<...>
STRIPE_SECRET_KEY=sk_test_<...>
# PayPal (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=<client id>
PAYPAL_CLIENT_SECRET=<secret>
PAYPAL_MODO=sandbox
# Openpay / Paynet (sandbox-dashboard.openpay.mx → la página de inicio muestra las llaves)
OPENPAY_MERCHANT_ID=<id del comercio>
OPENPAY_PRIVATE_KEY=sk_<...>
OPENPAY_PUBLIC_KEY=pk_<...>
OPENPAY_MODO=sandbox

# Seguridad. true cuando la app móvil ya mande el token de sesión (Authorization: Bearer).
# Mientras tanto déjalo en false: el panel de la página exige token de todos modos.
EXIGIR_TOKEN=false
