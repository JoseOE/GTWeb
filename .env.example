# Plantilla de configuración. Copia este archivo como ".env" (en la raíz del
# proyecto, junto a pom.xml) y sustituye los valores entre < >.
# El .env real NO se sube a GitHub; esta plantilla sí, para que cualquiera
# del equipo sepa qué necesita.

MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/gymtrackdb?retryWrites=true&w=majority
