# Plantilla de configuración de la tienda (Medusa). Copia este archivo como
# ".env" dentro de la carpeta medusa/ y sustituye los valores entre < >.
# El .env real NO se sube a GitHub.

# PostgreSQL en Neon (Dashboard de Neon > Connect). Debe terminar en ?sslmode=require.
DATABASE_URL=postgres://<usuario>:<contraseña>@<host>.neon.tech/<base>?sslmode=require

# Secretos internos de Medusa. Genera valores largos y aleatorios.
JWT_SECRET=<cadena aleatoria larga>
COOKIE_SECRET=<otra cadena aleatoria larga>

# Orígenes permitidos. Solo Spring llama a Medusa, así que basta con su dirección.
STORE_CORS=http://localhost:8080,https://gtweb.onrender.com
ADMIN_CORS=http://localhost:8080,https://gtweb.onrender.com
AUTH_CORS=http://localhost:8080,https://gtweb.onrender.com

# A dónde avisa Medusa cuando se paga o se cancela un pedido, y la clave con
# la que firma esos avisos (HMAC). Debe ser IDÉNTICA a MEDUSA_WEBHOOK_SECRET en Spring.
SPRING_WEBHOOK_URL=http://localhost:8080/api/tienda/webhooks/medusa
MEDUSA_WEBHOOK_SECRET=<cadena aleatoria larga>
